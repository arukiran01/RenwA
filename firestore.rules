rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Volunteers collection: Public read and write
    match /volunteers/{volunteerId} {
      allow read, write: if true;
    }

    // Initiatives collection: Public read and write
    match /initiatives/{initiativeId} {
      allow read, write: if true;
    }

    // System Metrics: Public read and write
    match /metrics/{metricId} {
      allow read, write: if true;
    }

    // Activity Logs: Public read and write
    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
